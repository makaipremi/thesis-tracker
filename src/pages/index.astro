---
import { loadTheses } from '../lib/data';

const base = import.meta.env.BASE_URL;
// Loading here makes every build validate all threads, until the real pages exist.
const theses = await loadTheses();
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<link rel="icon" href={`${base}favicon.ico`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Thesis Tracker — Alpha Beta Generator</title>
	</head>
	<body>
		<h1>Thesis Tracker</h1>
		<p>Alpha Beta Generator. Under construction.</p>
		<ul>
			{theses.map((t) => (
				<li>
					#{t.thread.number} {t.thread.opening.data.title} — {t.status},{' '}
					{t.performance ? `${t.performance.end.value.toFixed(2)}${t.performance.unit === 'yield' ? 'bp' : '%'}` : t.pending}
				</li>
			))}
		</ul>
	</body>
</html>
