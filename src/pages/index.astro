---
import Base from '../layouts/Base.astro';
import { loadTheses } from '../lib/data';
import { url } from '../lib/format';

const theses = await loadTheses();
---

<Base>
	<h1>Thesis Tracker</h1>
	<p>
		A public, timestamped record of my investment theses, losers included. Methodology and verification guide coming
		soon.
	</p>
	<p><a href={url('theses/')}>See all {theses.length} theses →</a></p>
</Base>
